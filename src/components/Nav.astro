---
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
---

<header class="lg:flex p-5 gap-5 border-b border-(--border)">
  <Astronav>
    <div class="flex w-full justify-between">
      <a
        href="/"
        class="font-mono text-(--text) hover:text-(--accent) transition-colors"
        >JO</a
      >
      <div class="block lg:hidden">
        <MenuIcon class="w-4 h-4 text-mahogny" />
      </div>
    </div>
    <MenuItems class="hidden lg:flex">
      <ul class="flex flex-col lg:flex-row lg:gap-5">
        <li>
          <a
            class="font-mono text-sm text-(--muted) hover:text-(--accent) transition-colors duration-200"
            href="/">Home</a>
        </li>
        <li>
          <a
            class="font-mono text-sm text-(--muted) hover:text-(--accent) transition-colors duration-200"
            href="/projects">Work</a>
        </li>
        <li>
          <a
            class="font-mono text-sm text-(--muted) hover:text-(--accent) transition-colors duration-200"
            href="/about">About</a>
        </li>
      </ul>
    </MenuItems>
    <button
      id="theme-toggle"
      class="font-mono text-xs text-[var(--muted)] hover:text-[var(--text)] transition-colors border border-[var(--border)] px-3 py-1 rounded-sm"
    >
      light
    </button>
  </Astronav>
</header>

<script defer>
  const toggle = document.getElementById("theme-toggle");
  const html = document.documentElement;

  const saved = localStorage.getItem("theme");
  if (saved) {
    html.setAttribute("data-theme", saved);
    toggle.textContent = saved === "light" ? "dark" : "light";
  }

  toggle.addEventListener("click", () => {
    const current = html.getAttribute("data-theme");
    const next = current === "light" ? "dark" : "light";
    html.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
    toggle.textContent = next === "light" ? "dark" : "light";
  });
</script>
