---
import MainLayout from "../../layout/MainLayout.astro";
import { projects } from "../../data/projects.js";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { projects: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const pageTitle = `${project.name} | Jakub Olszewski`;
const pageDescription = project.cardDescription;
---

<MainLayout title={pageTitle} description={pageDescription}>
  <div class="mx-auto max-w-3xl px-4 py-12 md:px-8 md:py-16">
    <p class="mb-4 font-mono text-xs uppercase tracking-widest text-(--accent)">
      {project.type}
    </p>
    <h1 class="mb-3 font-sans text-4xl text-(--text) md:text-5xl">{project.name}</h1>
    <p class="mb-2 font-mono text-sm text-(--muted)">
      {project.period} · {project.team}
    </p>
    {project.result && (
      <p class="mb-8 font-mono text-xs text-(--accent)">{project.result}</p>
    )}
    {!project.result && <div class="mb-8" />}

    {project.image ? (
      <img
        src={project.image}
        class="h-auto w-full rounded border border-(--border)"
        alt={project.imageAlt}
        width={project.imageWidth}
        height={project.imageHeight}
        fetchpriority="high"
        decoding="async"
      />
    ) : (
      <div class="project-placeholder aspect-video rounded border border-(--border)" aria-hidden="true">
        <span class="font-mono text-xs uppercase tracking-widest text-(--accent)">{project.type}</span>
        <span class="font-sans text-4xl text-(--text)">{project.name}</span>
        <span class="font-mono text-xs text-(--muted)">{project.imagePlaceholderCaption}</span>
      </div>
    )}

    <div class="mt-6 flex flex-wrap gap-2">
      {project.stack.map((technology) => <span class="pill">{technology}</span>)}
    </div>

    <section class="mt-8 border-t border-(--border) pt-8">
      <h2 class="mb-4 border-l-2 border-(--accent) pl-3 font-sans text-2xl text-(--text)">
        About the project
      </h2>
      {project.description.map((paragraph) => (
        <p class="mb-4 font-mono text-sm leading-relaxed text-(--text)">{paragraph}</p>
      ))}
      {project.note && (
        <p class="mt-4 font-mono text-xs text-(--muted)">{project.note}</p>
      )}
    </section>

    <section class="mt-8 border-t border-(--border) pt-8">
      <h2 class="mb-4 border-l-2 border-(--accent) pl-3 font-sans text-2xl text-(--text)">
        My contributions
      </h2>
      <ul class="list-disc space-y-3 pl-5 font-mono text-sm leading-relaxed text-(--text)">
        {project.contributions.map((contribution) => <li>{contribution}</li>)}
      </ul>
    </section>

    {project.links.length > 0 && (
      <section class="mt-8 border-t border-(--border) pt-8">
        <h2 class="mb-4 border-l-2 border-(--accent) pl-3 font-sans text-2xl text-(--text)">
          Links
        </h2>
        <div class="flex flex-wrap gap-x-6 gap-y-3">
          {project.links.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-sm text-(--accent) hover:underline"
            >{link.label} ↗</a>
          ))}
        </div>
      </section>
    )}

    <div class="mt-10 border-t border-(--border) pt-6">
      <a href="/projects" class="font-mono text-sm text-(--muted) transition-colors hover:text-(--accent)">
        ← Back to projects
      </a>
    </div>
  </div>
</MainLayout>
