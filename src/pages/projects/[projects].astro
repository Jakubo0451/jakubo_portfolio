---
import MainLayout from '../../layout/MainLayout.astro'

export async function getStaticPaths() {
    return [
        {params: {projects: 'studyfront'}, props: {
            name: 'Studyfront',
            desc: 'A research platform for conducting studies.',
        },
    },
            {params: {projects: 'bachelor'}, props: {
            name: 'Bachelor',
            desc: 'An AI learning platform with focus on pedagogic approach and cognitive understanding.',
        },
    },
          {params: {projects: 'yapper'}, props: {
            name: 'Yapper',
            desc: 'A social media platform stylized to look like Windows 95!',
        },
    },
        {params: {projects: 'cjs'}, props: {
            name: 'CJS',
            desc: 'Check if you can tell AI from real images!',
        },
    }
    ];
}

const {projects} = Astro.params;
const { name, desc} = Astro.props;

---

<MainLayout>
<section class="mx-auto w-3/6">
    <img src=`/images/${projects}-project-image.png` width="600" width="600" class="rounded">
    <h1 class="font-bold mt-4">Project: {name}</h1>
    <p>{desc}</p>
</section>
    
</MainLayout>