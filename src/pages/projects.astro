---
import MainLayout from "../layout/MainLayout.astro";
const projects = [
  { slug: 'studyfront', name: 'Studyfront',      desc: 'A research platform for conducting studies.' },
  { slug: 'bachelor',   name: 'Bachelor Thesis', desc: 'An AI learning platform with focus on pedagogic approach and cognitive understanding.' },
  { slug: 'yapper',     name: 'Yapper',          desc: 'A social media platform stylized to look like Windows 95!' },
  { slug: 'cjs',        name: 'AI Quiz App',     desc: 'Check if you can tell AI from real images!' },
]
---

<MainLayout
  title="Jakub Olszewski's Projects"
  seoDesc="A list of projects and experiences"
>
  <div class="w-8/12 lg:w-6/12 mx-auto">
    <p class="text-s my-6 text-(--accent)">My work</p>
    <div class="grid md:grid-cols-2 gap-6">
      {projects.map(p => (
        <div class="hover:scale-[1.02] transition-transform duration-300 bg-(--surface) border border-(--border) rounded-md overflow-hidden">
          <a href={`/projects/${p.slug}`}>
            <img class="aspect-video object-cover w-full" src={`/images/${p.slug}-project-image.png`} alt={p.name} />
          </a>
          <div class="p-4">
            <h2 class="text-2xl font-sans text-(--text)">Project: {p.name}</h2>
            <p class="font-mono text-sm text-(--muted) mt-1">{p.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</MainLayout>