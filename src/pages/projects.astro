---
import MainLayout from "../layout/MainLayout.astro";
---

<MainLayout
  title="Jakub Olszewski's Projects"
  seoDesc="A list of projects and experiences"
>
  <div
    class="w-8/12 lg:w-6/12 mx-auto drop-shadow-[10px_10px_10px_rgba(1,1,1,0.4)]"
  >
    <h1 class="text-5xl my-2">Projects</h1>
    <div class="grid md:grid-cols-2 gap-15">
      <div>
        <a href="/projects/studyfront"
          ><img
            class="my-10 rounded"
            src="/images/studyfront-project-image.png"
            width="500px"
            height="500px"
            alt=""
          /></a>
          <h1 class="text-2xl">Project: Studyfront</h1>
      </div>
      <div>
        <a href="/projects/bachelor"
          ><img
            class="my-10 rounded"
            src="/images/bachelor-project-image.png"
            width="500px"
            height="500px"
            alt=""
          /></a>
          <h1 class="text-2xl">Project: Bachelor Thesis</h1>
      </div>
      <div>
        <a href="/projects/yapper"
          ><img
            class="my-10 rounded"
            src="/images/yapper-project-image.png"
            width="500px"
            height="500px"
            alt=""
          /></a>
          <h1 class="text-2xl">Project: Yapper</h1>
      </div>
      <div>
        <a href="/projects/cjs"
          ><img
            class="my-10 rounded"
            src="/images/cjs-project-image.png"
            width="500px"
            height="500px"
            alt=""
          /></a
        >
        <h1 class="text-2xl">Project: AI quiz app</h1>
      </div>
    </div>
  </div>
</MainLayout>
