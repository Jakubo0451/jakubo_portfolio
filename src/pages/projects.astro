---
import MainLayout from "../layout/MainLayout.astro";
---

<MainLayout
  title="Jakub Olszewski's Projects"
  seoDesc="A list of projects and experiences"
>
  <div class="w-8/12 lg:w-6/12 mx-auto drop-shadow-[10px_10px_10px_rgba(1,1,1,0.4)]">
    <h1 class="text-5xl my-2">Projects</h1>
    <div class="grid md:grid-cols-2 gap-3">
      <a href="/projects/studyfront"
        ><img
          class="my-10 rounded"
          src="/images/studyfront-project-image.png"
          width="300px"
          height="300px"
          alt=""
        /></a
      >
      <a href="/projects/bachelor"
        ><img
         class="my-10 rounded"
          src="/images/bachelor-project-image.png"
          width="300px"
          height="300px"
          alt=""
        /></a
      >
      <a href="/projects/yapper"
        ><img
         class="my-10 rounded"
          src="/images/yapper-project-image.png"
          width="300px"
          height="300px"
          alt=""
        /></a
      >
      <a href="/projects/studyfront"
        ><img
          class="my-10 rounded"
          src="/images/studyfront-project-image.png"
          width="300px"
          height="300px"
          alt=""
        /></a
      >
    </div>
  </div>
</MainLayout>
