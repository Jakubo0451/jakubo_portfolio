---
import MainLayout from "../layout/MainLayout.astro";
import { projects } from "../data/projects.js";
---

<MainLayout
  title="Projects | Jakub Olszewski"
  description="Selected web development projects by Jakub Olszewski, including Ellerin, Studyfront, Skycast, Yapper and CJS."
>
  <div class="mx-auto w-11/12 max-w-6xl py-12 md:w-10/12 md:py-16">
    <p class="my-3 font-mono text-xs text-(--accent)">Selected work</p>
    <h1 class="mb-4 font-sans text-4xl text-(--text)">Projects</h1>
    <p class="mb-10 max-w-3xl font-mono text-sm leading-relaxed text-(--muted)">
      A selection of university and personal projects. Each page describes the project, the technologies used and my contributions.
    </p>

    <div class="grid gap-6 md:grid-cols-2">
      {projects.map((project) => (
        <article class="project-card flex h-full flex-col overflow-hidden rounded-md border border-(--border) bg-(--surface)">
          <a
            class="project-card-image-link block overflow-hidden"
            href={`/projects/${project.slug}`}
            aria-label={`View ${project.name} project details`}
          >
            {project.image ? (
              <img
                class="project-card-image aspect-video w-full object-cover"
                src={project.image}
                alt={project.imageAlt}
                width={project.imageWidth}
                height={project.imageHeight}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="project-placeholder aspect-video" aria-hidden="true">
                <span class="font-mono text-xs uppercase tracking-widest text-(--accent)">{project.type}</span>
                <span class="font-sans text-4xl text-(--text)">{project.name}</span>
                <span class="font-mono text-xs text-(--muted)">{project.imagePlaceholderCaption}</span>
              </div>
            )}
          </a>

          <div class="flex flex-1 flex-col p-4">
            <p class="font-mono text-xs text-(--accent)">{project.type} · {project.team}</p>
            <h2 class="mt-2 font-sans text-2xl text-(--text)">
              <a class="transition-colors hover:text-(--accent)" href={`/projects/${project.slug}`}>
                {project.name}
              </a>
            </h2>
            <p class="mt-2 font-mono text-sm leading-relaxed text-(--muted)">{project.cardDescription}</p>

            <div class="mt-4 flex flex-wrap gap-2">
              {project.stack.slice(0, 5).map((technology) => (
                <span class="pill">{technology}</span>
              ))}
            </div>

            <a
              href={`/projects/${project.slug}`}
              class="mt-auto pt-5 inline-block font-mono text-sm text-(--accent) hover:underline"
            >Project details ↗</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</MainLayout>
