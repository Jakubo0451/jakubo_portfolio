---
import MainLayout from "../layout/MainLayout.astro";

const skills = [
  "HTML",
  "CSS",
  "SCSS",
  "JavaScript",
  "React",
  "Next.js",
  "Tailwind CSS",
  "Astro",
  "Node.js",
  "Express.js",
  "Python",
  "FastAPI",
  "MongoDB",
  "Mongoose",
  "PostgreSQL",
  "SQL",
  "SQLAlchemy",
  "REST APIs",
  "Git",
  "GitHub",
  "Postman",
  "Docker",
  "Linux",
  "Jest",
  "Puppeteer",
  "WCAG",
  "Figma",
  "Adobe Illustrator",
  "Adobe Photoshop",
  "TypeScript (currently learning)",
];
---

<MainLayout
  title="About | Jakub Olszewski"
  description="About Jakub Olszewski, an NTNU Web Development graduate with experience in React, full-stack development, accessibility and data centre operations."
>
  <div class="mx-auto max-w-185 px-8 py-16 md:py-20">
    <p class="mb-3 font-mono text-xs text-(--accent)">A little about me</p>
    <h1 class="mb-10 font-sans text-4xl text-(--text)">About</h1>

    <section class="mb-10 overflow-hidden rounded-md border border-(--border) bg-(--surface) p-4">
      <h2 class="mb-3 border-l-2 border-(--accent) pl-3 font-sans text-3xl text-(--text)">
        What I Build
      </h2>
      <p class="font-mono leading-relaxed">
        I am a web developer with a frontend focus, primarily working with
        JavaScript and React. I enjoy building interfaces and connecting them to
        the backend systems that make them work. My project experience includes
        developing REST APIs, implementing authentication, modelling databases
        and integrating frontend applications with backend services. I have also
        worked with Next.js and used Python, FastAPI and PostgreSQL in a
        university project.
      </p>
      <p class="mt-5">Technologies and tools:</p>
      <div class="mb-4 mt-4 flex flex-wrap gap-2">
        {skills.map((skill) => (
          <span class="pill">{skill}</span>
        ))}
      </div>
    </section>

    <section class="mb-10 overflow-hidden rounded-md border border-(--border) bg-(--surface) p-4">
      <h2 class="mb-3 border-l-2 border-(--accent) pl-3 font-sans text-3xl text-(--text)">
        How I Work
      </h2>
      <p class="font-mono leading-relaxed">
        I value code that is easy to understand, maintain and build upon. I pay
        attention to how different parts of an application work together, from
        frontend state and API communication to data handling and error
        management. When something goes wrong, I prefer to trace the problem to
        its source rather than work around the symptoms.
      </p>
    </section>

    <section class="mb-10 overflow-hidden rounded-md border border-(--border) bg-(--surface) p-4">
      <h2 class="mb-3 border-l-2 border-(--accent) pl-3 font-sans text-3xl text-(--text)">
        Experience
      </h2>
      <div class="font-mono leading-relaxed">
        <h3 class="text-(--text)">Data Center Operations Intern</h3>
        <p class="mt-1 text-sm text-(--muted)">
          TikTok, Green Mountain Data Center, Hamar | June to August 2025
        </p>
        <p class="mt-4">
          I worked with server and network hardware, including SSDs, HDDs, power
          supply units and network switches. My responsibilities also included
          cleaning and troubleshooting fibre-optic cables and using Linux logs
          and command-line tools to investigate hardware issues. I assisted with
          infrastructure installations, including equipment racking, cabling,
          labelling and connection checks. I also coordinated external vendors
          responsible for installing other components, and followed up
          operational incidents through an internal ticketing system. The role
          gave me practical experience with hardware diagnostics, infrastructure
          operations and working in an environment where careful documentation
          and reliable procedures matter.
        </p>
      </div>
    </section>

    <section class="overflow-hidden rounded-md border border-(--border) bg-(--surface) p-4">
      <h2 class="mb-3 border-l-2 border-(--accent) pl-3 font-sans text-3xl text-(--text)">
        Let's Connect
      </h2>
      <p class="font-mono leading-relaxed">
        Always happy to chat or hear about new opportunities.
      </p>
      <ul class="mt-3 flex flex-col gap-2">
        <li>
          <a
            href="https://github.com/Jakubo0451"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-sm text-(--muted) transition-colors hover:text-(--accent)"
          >
            GitHub ↗
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/jakub-olszewski-43922534a/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-sm text-(--muted) transition-colors hover:text-(--accent)"
          >
            LinkedIn ↗
          </a>
        </li>
        <li>
          <a
            href="mailto:jakubolszewski451@gmail.com"
            class="font-mono text-sm text-(--muted) transition-colors hover:text-(--accent)"
          >
            jakubolszewski451@gmail.com
          </a>
        </li>
      </ul>
    </section>
  </div>
</MainLayout>
